          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "line": {
            "type": "integer"
          }
        }
      }
    },
    "titles": {
      "type": "object",
      "maxProperties": 3000,
      "propertyNames": {
        "pattern": "^-?[0-9]+$"
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 120
      }
    },
    "errors": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "maxLength": 120
          },
          "message": {
            "type": "string",
            "maxLength": 300
          },
          "guide": {
            "type": "string",
            "maxLength": 80
          },
          "step": {
            "type": "integer"
          },
          "map": {
            "type": "integer"
          }
        }
      }
    },
    "reports": {
      "type": "array",
      "maxItems": 300,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "maxLength": 40
          },
          "mode": {
            "type": "string",
            "maxLength": 20
          },
          "what": {
            "type": "string",
            "maxLength": 40
          },
          "guide": {
            "type": "string",
            "maxLength": 80
          },
          "step": {
            "type": "integer"
          },
          "q": {
            "type": "integer"
          },
          "text": {
            "type": "string",
            "maxLength": 200
          },
          "title": {
            "type": "string",
            "maxLength": 120
          },
          "questLevel": {
            "type": "integer"
          },
          "ready": {
            "type": "boolean"
          },
          "failed": {
            "type": "boolean"
          },
          "m": {
            "type": "integer"
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "zone": {
            "type": "string",
            "maxLength": 80
          },
          "sub": {
            "type": "string",
            "maxLength": 80
          },
          "lvl": {
            "type": "integer"
          },
          "npc": {
            "type": "integer"
          },
          "npcName": {
            "type": "string",
            "maxLength": 80
          },
          "npcStep": {
            "type": "integer"
          },
          "race": {
            "type": "string",
            "maxLength": 20
          },
          "class": {
            "type": "string",
            "maxLength": 20
          },
          "faction": {
            "type": "string",
            "maxLength": 20
          },
          "loc": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "m": {
                "type": "integer"
              },
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "id": {
                "type": "integer"
              },
              "kind": {
                "type": "string",
                "maxLength": 20
              }
            }
          },
          "objectives": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "text": {
                  "type": "string",
                  "maxLength": 160
                },
                "numFulfilled": {
                  "type": "integer"
                },
                "numRequired": {
                  "type": "integer"
                },
                "finished": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 16
        },
        "seg": {
          "type": "integer"
        },
        "done": {
          "type": "boolean"
        },
        "entries": {
          "type": "array",
          "maxItems": 2500,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "e": {
                "type": "string",
                "maxLength": 10
              },
              "t": {
                "type": "number"
              },
              "lvl": {
                "type": "integer"
              },
              "m": {
                "type": "integer"
              },
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "g": {
                "type": "string",
                "maxLength": 80
              },
              "s": {
                "type": "integer"
              },
              "q": {
                "type": "integer"
              },
              "xp": {
                "type": "integer"
              },
              "money": {
                "type": "integer"
              },
              "obj": {
                "type": "integer"
              },
              "f": {
                "type": "integer"
              },
              "r": {
                "type": "integer"
              },
              "done": {
                "type": "boolean"
              },
              "l": {
                "type": "integer"
              },
              "rested": {
                "type": "integer"
              },
              "npc": {
                "type": "integer"
              },
              "mobLevel": {
                "type": "integer"
              },
              "elite": {
                "type": "boolean"
              },
              "secs": {
                "type": "number"
              },
              "mounted": {
                "type": "boolean"
              },
              "taxi": {
                "type": "boolean"
